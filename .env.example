# Default configuration

# Extra pre-declared entries
COMPOSE_PROJECT_NAME=go42

## Core

# ServiceName (string)
SERVICE_NAME=go42
# Environment (string)
ENVIRONMENT=default
# StartupConnectTimeout (time.Duration)
# Tag: v -> gt=0
STARTUP_CONNECT_TIMEOUT=1m
# StartupRetryInitialBackoff (time.Duration)
# Tag: v -> gt=0
STARTUP_RETRY_INITIAL_BACKOFF=500ms
# StartupRetryMaxBackoff (time.Duration)
# Tag: v -> gt=0
STARTUP_RETRY_MAX_BACKOFF=5s
# ReadinessCheckTimeout (time.Duration)
# Tag: v -> gt=0
READINESS_CHECK_TIMEOUT=2s
# ReadinessCheckInterval (time.Duration)
# Tag: v -> gt=0
READINESS_CHECK_INTERVAL=5s
# ShutdownGracePeriod (time.Duration)
SHUTDOWN_GRACE_PERIOD=10s
# ShutdownWaitForProbe (time.Duration)
SHUTDOWN_WAIT_FOR_PROBE=2s
# ShutdownComponentTimeout (time.Duration)
# Tag: v -> gt=0
SHUTDOWN_COMPONENT_TIMEOUT=3s

## Limits

# AutoMemLimitEnabled (bool)
AUTOMEMLIMIT_ENABLED=false
# MemLimitRatio (float64)
# Tag: v -> gte=0.2,lte=1.0
MEMLIMIT_RATIO=0.9

## Logger

# LogLevel (string)
# Tag: v -> oneof=debug info warn error
LOG_LEVEL=info
# LogOutput (string)
# Tag: v -> oneof=none stdout stderr file
LOG_OUTPUT=stdout
# LogFormat (string)
# Tag: v -> oneof=json text tint
LOG_FORMAT=json
# AddSource (bool)
LOG_ADD_SOURCE=true

## Tracing

# Enable (bool)
TRACING_ENABLED=false
# Provider (string)
# Tag: v -> oneof=otel
TRACING_PROVIDER=otel
# SamplingRate (float64)
# Tag: v -> gte=0.0,lte=1.0
TRACING_SAMPLING_RATE=1.0
# Timeout (time.Duration)
TRACING_TIMEOUT=5s
# MaxExportBatchSize (int)
TRACING_MAX_EXPORT_BATCH_SIZE=100
# MaxQueueSize (int)
TRACING_MAX_QUEUE_SIZE=1000

## Tracing.Otel

# GrpcHost (string)
TRACING_OTEL_GRPC_HOST=localhost:4317

## Sentry

# Enabled (bool)
SENTRY_ENABLED=false
# DSN (string)
SENTRY_DSN=
# Debug (bool)
SENTRY_DEBUG=false
# AddSource (bool)
SENTRY_ADD_SOURCE=true
# Stacktrace (bool)
SENTRY_STACKTRACE=false
# SampleRate (float64)
# Tag: v -> gte=0.0,lte=1.0
SENTRY_SAMPLE_RATE=1.0

## Vault

# Enabled (bool)
VAULT_ENABLED=false
# Host (string)
VAULT_HOST=http://localhost:8200
# Timeout (time.Duration)
VAULT_TIMEOUT=5s
# AuthType (string)
VAULT_AUTH_TYPE=token
# Token (string)
VAULT_TOKEN=qwerty
# SecretPath (string)
VAULT_SECRET_PATH=/secret/data/github.com/go42-dev/go42
# MountPath (string)
VAULT_MOUNT_PATH=secret

## Etcd

# Enabled (bool)
ETCD_ENABLED=false
# Hosts ([]string)
ETCD_HOST=localhost:2379
# Timeout (time.Duration)
ETCD_TIMEOUT=5s
# Method (string)
ETCD_METHOD=bind
# SyncInterval (time.Duration)
ETCD_SYNC_INTERVAL=5m

## Database

# Engine (string)
